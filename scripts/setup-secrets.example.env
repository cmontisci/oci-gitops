# Copia in setup-secrets.env (gitignored), compila, poi:
#   bash scripts/setup-secrets.sh
#
# Esegui dove kubectl punta al cluster (di solito SSH sulla VM con KUBECONFIG=/etc/rancher/k3s/k3s.yaml).

# --- apps (production) ---
APPS_POSTGRES_USER=postgres
APPS_POSTGRES_PASSWORD=
APPS_POSTGRES_DB=postgres
APPS_VALKEY_PASSWORD=
APPS_PGADMIN_EMAIL=
APPS_PGADMIN_PASSWORD=

# --- apps-staging ---
STAGING_POSTGRES_USER=postgres
STAGING_POSTGRES_PASSWORD=
STAGING_POSTGRES_DB=postgres
STAGING_VALKEY_PASSWORD=

# --- monitoring (Grafana Cloud Loki) — opzionale finché non usi Alloy ---
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
